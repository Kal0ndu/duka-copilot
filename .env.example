# =====================================================================
# Duka — Example Environment Configuration
# Copy this file to .env and configure your local values.
# Never commit your actual .env file.
# =====================================================================

# ---- LLM ----
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=google
MODEL_NAME=gemini-3.8-flash

# ---- Limits ----
CAP_PER_TXN=2500000
CAP_DAILY=5000000
SAFETY_BUFFER_MINOR=500000
BUFFER_DAYS_OF_OUTFLOW=3

# ---- Synthetic data ----
SYNTHETIC_DATA_SEED=400
SANDBOX_ONLY=true

# ---- LLM cache ----
LLM_CACHE_DIR=.llm_cache

# ---- Database ----
DUKA_DB_PATH=data/duka.db

# ---- Authentication (Phase 1) ----
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRY_HOURS=24
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ---- SMS Provider ----
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_FROM=your_verified_sender_or_phone_number

# ---- Redis (optional) ----
REDIS_URL=

# ---- Admin ----
ADMIN_EMAIL=admin@example.com

# ---- M-Pesa Daraja (standing-order payments) ----
# Documentation: docs/MPESA_DARAJA_SETUP.md
# Portal: https://developer.safaricom.co.ke/MyApps

DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_INITIATOR_NAME=your_initiator_name
DARAJA_INITIATOR_PASSWORD=your_initiator_password
DARAJA_PARTY_A=your_test_party_a
DARAJA_PARTY_B=your_test_party_b
DARAJA_PHONE_NUMBER=your_test_phone_number
DARAJA_SHORTCODE=your_test_shortcode
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://example.com/mpesa/callback
APP_BASE_URL=http://localhost:8501
